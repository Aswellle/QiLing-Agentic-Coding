{
  "name": "qiling",
  "version": "0.1.0",
  "description": "启灵 (QiLing) — AI Programming Agent for the terminal",
  "bin": {
    "qiling": "./src/main.tsx"
  },
  "scripts": {
    "dev": "bun run src/main.tsx",
    "build": "bun build src/main.tsx --compile --outfile dist/qiling --minify",
    "build:win": "bun build src/main.tsx --compile --target bun-windows-x64 --outfile dist/qiling.exe --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "bunx @biomejs/biome check src/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "figlet": "^1.8.0",
    "gradient-string": "^3.0.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "lodash-es": "^4.17.21",
    "openai": "^6.35.0",
    "react": "^18.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/figlet": "^1.5.8",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.3",
    "bun-types": "latest",
    "typescript": "^5.8.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
